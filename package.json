{
  "name": "iripo",
  "version": "0.3.1",
  "description": "A mutation observer based livequery replacement.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": "git@github.com:nullset/iripo.git",
  "author": "Nathan Wright <nathan@brandalism.com>",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --minify --sourcemap=external && tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "test": "playwright test",
    "test:server": "bun run tests/server.ts",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "not-so-weak": "^2.0.0",
    "requestidlecallback-polyfill": "^1.0.2"
  },
  "keywords": [
    "jquery",
    "mutation",
    "observer",
    "livequery",
    "typescript"
  ]
}
